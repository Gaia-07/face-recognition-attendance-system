# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Biometric Privacy
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=dGhpc19pc19hX2R1bW15X2tleV9mb3JfZGV2X29ubHlfMzJiPQ==
SECRET_KEY=change_this_to_a_secure_random_jwt_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Privacy Policy Flags
STORE_RAW_IMAGES=false
ENABLE_AUDIT_LOG=true

# Database
DATABASE_URL=sqlite:///./data/fras.db

# Attendance Business Rules
LATE_CUTOFF_TIME=09:15:00
DEFAULT_SESSION_DURATION_HOURS=2

# Recognition Configuration
ACTIVE_BACKEND=avatar_cnn
SIMULATION_MODE=true
QUALITY_BLUR_THRESHOLD=60.0
QUALITY_MIN_FACE_SIZE=64
QUALITY_MIN_BRIGHTNESS=40.0
QUALITY_MAX_BRIGHTNESS=220.0
TEMPORAL_VOTING_K=3
TEMPORAL_VOTING_N=5

# API & Dashboard
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
